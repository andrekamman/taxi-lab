# Host folder that will hold everything: raw parquet, normalized parquet,
# mdf/ldf, and backups. Must exist before the first run.
TAXI_DATA_DIR=/srv/taxi

# SA password. Must satisfy SQL Server's complexity policy or the mssql
# container exits during startup.
MSSQL_PASSWORD=change-me-Str0ng!

# Which series to mirror, normalize and load. Default is all four.
TAXI_TYPES=yellow,green,fhv,fhvhv

# Blank means full history. Set to N for the N most recent months --
# TAXI_RECENT=1 is the fast smoke path.
TAXI_RECENT=

# mdf size = normalized parquet bytes x this factor, rounded up to the next
# 1 GB below a 10 GB implied size, else the next 10 GB.
# ESTIMATE, not a measurement -- calibrate after the first full run.
TAXI_DATA_FACTOR=3.0

# Skip the estimate entirely. Use on a first run when the eventual scope is
# already known; sizing only ever runs at database creation.
MSSQL_DATA_SIZE_GB=

# Skip the log's own estimate and use this instead. Left blank, the ldf
# defaults to 25% of the mdf size, floored at 1 GB and capped at 16 GB -- under
# SIMPLE recovery with TABLOCK bulk loads the log truncates on checkpoint and
# never tracks data volume, so 16 GB is a ceiling, not a target.
MSSQL_LOG_SIZE_GB=
MSSQL_FILEGROWTH_MB=1024

# Connection and naming. The defaults match the Compose stack; override only if
# you know why. MSSQL_DATABASE and MSSQL_SCHEMA are interpolated into T-SQL, so
# they must be plain identifiers ([A-Za-z_][A-Za-z0-9_]*) -- a name like
# "taxi-db" is legal in SQL Server but rejected here, at startup.
#MSSQL_HOST=mssql
#MSSQL_PORT=1433
#MSSQL_DATABASE=taxi
#MSSQL_SCHEMA=dbo
#MSSQL_USER=sa
