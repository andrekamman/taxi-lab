# Build context for seeder/Dockerfile is the repo root (see
# seeder/docker-compose.yml: context: ..), so this file lives here, not in
# seeder/. Docker COPY has no concept of .gitignore and copies dotfiles, so
# without this, `COPY seeder/ ./seeder/` bakes seeder/.env -- including a
# real SA password -- into an image layer.
seeder/.env

.git
.venv
__pycache__
*.egg-info
dist
build
.pytest_cache
.superpowers
data/
